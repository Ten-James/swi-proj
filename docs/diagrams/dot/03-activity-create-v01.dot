digraph G {
  graph [rankdir=TB, fontname="Arial", labelloc="t", label="Activity — Create Reservation v0.1"];
  node [fontname="Arial"]; edge [fontname="Arial"];
  A [shape=box, label="Create request"];
  B [shape=diamond, label="Input and interval valid?"];
  C [shape=diamond, label="Agent exists and active?"];
  D [shape=diamond, label="Overlap with CONFIRMED?"];
  E [shape=diamond, label="User below active\nreservation limit?"];
  F [shape=box, label="Create CONFIRMED Reservation"];
  G [shape=box, label="Return reservation ID\nand state"];
  X [shape=box, label="Reject - create nothing"];
  A->B; B->X[label="No"]; B->C[label="Yes"]; C->X[label="No"]; C->D[label="Yes"];
  D->X[label="Yes"]; D->E[label="No"]; E->X[label="No"]; E->F[label="Yes"]; F->G;
}
